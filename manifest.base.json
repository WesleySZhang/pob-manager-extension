{
  "manifest_version": 3,
  "name": "PoB Manager",
  "version": "0.1.2",
  "description": "Unofficial. Records the Path of Building share links you open (pobb.in, poe.ninja, Maxroll, ...) and lists them with filters.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PoB Manager",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pobb.in/*",
    "https://poe.ninja/*",
    "https://maxroll.gg/*",
    "https://pob.codes/*",
    "https://api.pob.codes/*",
    "https://poedb.tw/*",
    "https://pastebin.com/*",
    "https://pastebinp.com/*",
    "https://rentry.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pobb.in/*",
        "https://poe.ninja/*",
        "https://maxroll.gg/*",
        "https://pob.codes/*",
        "https://poedb.tw/*",
        "https://pastebin.com/*",
        "https://pastebinp.com/*",
        "https://rentry.co/*"
      ],
      "js": [
        "src/xml.js",
        "src/buildinfo.js",
        "src/filter.js",
        "src/buildview.js",
        "src/page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
